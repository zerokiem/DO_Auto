# ============================================================================
# Cau hinh RIENG cho may nay. Copy file nay thanh `.env` roi sua neu can:
#     cp .env.example .env
# `docker compose` tu doc file .env cung thu muc. File .env KHONG duoc commit
# len git (da co trong .gitignore) nen moi may giu cau hinh rieng cua minh.
#
# Chay duoc NGAY voi mac dinh ben duoi (khong sua gi) tren may co Docker; cac
# muc "tuy chon" chi can khi ban muon bam mo file tu Excel tren may khac.
# ============================================================================

# Cong web dashboard (mac dinh 8877). Doi neu cong nay da bi ung dung khac dung.
DOFFICE_PORT=8877

# Mui gio cua container (dung cho tab "Lich chay" chay dung gio dia phuong).
TZ=Asia/Ho_Chi_Minh

# Thu muc tren MAY CHU (host) de luu PDF/Excel/log/DB.
# - Mac dinh ./data: tao ngay trong thu muc repo (don gian, thay ngay).
# - Doi thanh duong dan tuyet doi neu muon luu cho khac, vi du tren NAS Synology:
#       DOFFICE_DATA_HOST=/volume1/homes/binhnx/Working/Van_ban
DOFFICE_DATA_HOST=./data

# ---------------------------------------------------------------------------
# (TUY CHON) Chi can khi chay Docker/NAS va muon hyperlink PDF mo qua web.
# ---------------------------------------------------------------------------

# Link mo file qua WEB (hyperlink cot "Ten file luu"), vd qua Tailscale de bam
# mo duoc ca tren dien thoai. De trong -> dung link file:// (chi phu hop Windows).
# Gia tri phai ket thuc bang /vb, vi du:
#     DOFFICE_DISPLAY_URL=http://100.100.1.254:8877/vb
DOFFICE_DISPLAY_URL=

# ---------------------------------------------------------------------------
# (TUY CHON) Thong bao Telegram. Khong ghi token truc tiep vao config.py/git.
# ---------------------------------------------------------------------------
DOFFICE_TELEGRAM_ENABLED=false
DOFFICE_TELEGRAM_BOT_TOKEN=
DOFFICE_TELEGRAM_CHAT_ID=
DOFFICE_TELEGRAM_ONLY_IF_NEW=true
